# titan117-pop: copy to .env.local (git-ignored) and fill in. Never put real values in this file.

# Clerk STAFF application (separate from the customer one), Invite-only.
# Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Two-factor is required unless this is exactly "off-until-clerk-pro"
# (Clerk's free plan has no multi-factor). Remove before phase 5 (decisions §37).
PORTAL_TWO_FACTOR=off-until-clerk-pro
